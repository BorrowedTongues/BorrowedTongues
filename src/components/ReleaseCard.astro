---
import type { Release } from '../config/releases';
import ProgressiveImage from './ProgressiveImage.astro';

interface Props {
  release: Release;
}

const { release } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = `${base}releases/${release.id}`;
---

<article class="release-card">
  <a href={href} class="card-link" aria-label={`${release.title} — ${release.subtitle}`}>
    <ProgressiveImage
      src={`${base}images/${release.coverArt}`}
      alt={`Cover art for ${release.title}`}
      width={600}
      height={600}
      class="card-art"
    />
    <div class="card-body">
      <div class="card-badges">
        <span class="badge badge--accent">{release.language}</span>
        <span class="badge badge--punk">{release.genre}</span>
      </div>
      <h2 class="card-title">{release.title}</h2>
      <p class="card-subtitle">{release.subtitle}</p>
      <p class="card-meta">
        <span class="card-year">{release.year}</span>
        <span class="card-type">{release.type === 'album' ? `${release.tracks.length} tracks` : 'Single'}</span>
      </p>
    </div>
  </a>
</article>

<style>
  .release-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    transition: transform 0.2s ease, border-top-color 0.2s ease;
  }
  .release-card:hover {
    transform: translateY(-2px);
    border-top-color: var(--color-accent);
  }
  .card-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  /* Scope into the ProgressiveImage component for the hover zoom */
  .release-card:hover :global(.pi-img) {
    transform: scale(1.03);
  }
  :global(.card-art.pi-wrap) {
    background: var(--color-bg);
  }
  :global(.card-art .pi-img) {
    transition: opacity 0.4s ease, transform 0.4s ease;
  }

  .card-body {
    padding: 1.25rem;
  }
  .card-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 0.75rem;
  }
  .card-title {
    font-family: var(--font-secondary);
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 0.2rem;
    color: var(--color-text-primary);
  }
  .card-subtitle {
    font-family: var(--font-body);
    font-style: italic;
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    margin-bottom: 0.75rem;
  }
  .card-meta {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.06em;
    color: var(--color-text-secondary);
    text-transform: uppercase;
    border-top: 1px solid var(--color-border);
    padding-top: 0.65rem;
  }
</style>
