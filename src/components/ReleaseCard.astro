---
import type { Release } from '../config/releases';
import { siteConfig } from '../config/releases';

interface Props {
  release: Release;
}

const { release } = Astro.props;
const base = siteConfig.baseUrl;
const href = `${base}/releases/${release.id}`;
---

<article class="release-card">
  <a href={href} class="card-link" aria-label={`${release.title} — ${release.subtitle}`}>
    <div class="card-art">
      <img
        src={`${base}/images/${release.coverArt}`}
        alt={`Cover art for ${release.title}`}
        onerror="this.style.display='none';this.nextElementSibling.style.display='flex';"
        loading="lazy"
      />
      <div class="cover-placeholder" style="display:none; aspect-ratio:1;">
        <span>{release.title}</span>
      </div>
    </div>
    <div class="card-body">
      <div class="card-badges">
        <span class="badge badge--accent">{release.language}</span>
        <span class="badge badge--punk">{release.genre}</span>
      </div>
      <h2 class="card-title">{release.title}</h2>
      <p class="card-subtitle">{release.subtitle}</p>
      <p class="card-meta">
        <span class="card-year">{release.year}</span>
        <span class="card-type">{release.type === 'album' ? `${release.tracks.length} tracks` : 'Single'}</span>
      </p>
    </div>
  </a>
</article>

<style>
  .release-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    transition: transform 0.2s ease, border-top-color 0.2s ease;
  }
  .release-card:hover {
    transform: translateY(-2px);
    border-top-color: var(--color-accent);
  }
  .card-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .card-art {
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--color-bg);
  }
  .card-art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }
  .release-card:hover .card-art img {
    transform: scale(1.03);
  }
  .cover-placeholder {
    width: 100%;
    aspect-ratio: 1;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2rem;
  }
  .cover-placeholder span {
    font-family: var(--font-display);
    font-size: 1rem;
    color: var(--color-text-secondary);
    letter-spacing: 0.04em;
  }
  .card-body {
    padding: 1.25rem;
  }
  .card-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 0.75rem;
  }
  .card-title {
    font-size: 1.15rem;
    font-weight: 600;
    margin-bottom: 0.2rem;
    color: var(--color-text-primary);
  }
  .card-subtitle {
    font-family: var(--font-body);
    font-style: italic;
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    margin-bottom: 0.75rem;
  }
  .card-meta {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.06em;
    color: var(--color-text-secondary);
    text-transform: uppercase;
    border-top: 1px solid var(--color-border);
    padding-top: 0.65rem;
  }
</style>
